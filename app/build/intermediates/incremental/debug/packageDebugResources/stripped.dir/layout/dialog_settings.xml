<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/apple_canvas"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings &amp; Tuning"
            android:textColor="@color/apple_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="-0.015"
            android:layout_marginBottom="16dp" />

        <!-- Sensitivity X -->
        <TextView
            android:id="@+id/tvLabelSensX"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensitivity X (Yaw): 0.22"
            android:textColor="@color/apple_text_secondary"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seekSensX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="22"
            android:progressTint="@color/apple_blue"
            android:thumbTint="@color/apple_blue"
            android:layout_marginBottom="12dp" />

        <!-- Sensitivity Y -->
        <TextView
            android:id="@+id/tvLabelSensY"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensitivity Y (Pitch): 0.22"
            android:textColor="@color/apple_text_secondary"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seekSensY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="22"
            android:progressTint="@color/apple_blue"
            android:thumbTint="@color/apple_blue"
            android:layout_marginBottom="12dp" />

        <!-- Gyro Deadzone -->
        <TextView
            android:id="@+id/tvLabelDeadzone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gyro Deadzone: 1.25 deg/s"
            android:textColor="@color/apple_text_secondary"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seekDeadzone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50"
            android:progress="12"
            android:progressTint="@color/apple_amber"
            android:thumbTint="@color/apple_amber"
            android:layout_marginBottom="12dp" />

        <!-- Smoothing Alpha -->
        <TextView
            android:id="@+id/tvLabelAlpha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filter Smoothing Alpha: 0.45"
            android:textColor="@color/apple_text_secondary"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seekAlpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="45"
            android:progressTint="@color/apple_green"
            android:thumbTint="@color/apple_green"
            android:layout_marginBottom="16dp" />

        <!-- Apple Switches -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAccel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Velocity Acceleration"
            android:textColor="@color/apple_text_primary"
            android:checked="true"
            app:thumbTint="@color/apple_blue"
            app:trackTint="@color/apple_blue_subtle" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchInvertX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Invert Horizontal Axis (X)"
            android:textColor="@color/apple_text_primary"
            android:checked="true"
            app:thumbTint="@color/apple_blue"
            app:trackTint="@color/apple_blue_subtle" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchInvertY"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Invert Vertical Axis (Y)"
            android:textColor="@color/apple_text_primary"
            android:checked="true"
            app:thumbTint="@color/apple_blue"
            app:trackTint="@color/apple_blue_subtle" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchVolumeKeys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Physical Volume Rocker Shortcuts"
            android:textColor="@color/apple_text_primary"
            android:checked="true"
            app:thumbTint="@color/apple_amber"
            app:trackTint="@color/apple_amber_subtle" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchHaptics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Taptic Haptic Feedback"
            android:textColor="@color/apple_text_primary"
            android:checked="true"
            app:thumbTint="@color/apple_green"
            app:trackTint="@color/apple_green_subtle" />

        <!-- Wi-Fi Companion Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_apple_card"
            android:padding="14dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WI-FI COMPANION SERVER"
                android:textColor="@color/apple_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvWifiServerInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WebSocket Server Active on port 8765\nAllows zero-bluetooth operation on local network."
                android:textColor="@color/apple_text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Close Button -->
        <Button
            android:id="@+id/btnCloseSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Save &amp; Close"
            android:textColor="@color/apple_text_primary"
            android:textStyle="bold"
            android:background="@drawable/bg_apple_btn_primary" />

    </LinearLayout>
</ScrollView>
