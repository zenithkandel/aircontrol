<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/apple_canvas"
    android:padding="16dp">

    <!-- Top Apple Navigation Bar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AirControl"
                android:textColor="@color/apple_text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="-0.015" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spatial Remote &amp; Controller"
                android:textColor="@color/apple_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Settings Frosted Button -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_apple_btn_secondary"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="@color/apple_text_secondary"
            android:contentDescription="Settings" />
    </LinearLayout>

    <!-- Apple Dynamic Status Pill -->
    <LinearLayout
        android:id="@+id/statusPillLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_apple_pill_status"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/dotConnection"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_apple_dot_status"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PAIRING: AIRCONTROL"
            android:textColor="@color/apple_blue"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDeviceTarget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bluetooth Active"
            android:textColor="@color/apple_text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Apple Segmented Mode Controller -->
    <LinearLayout
        android:id="@+id/modeTabBar"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_apple_segmented_track"
        android:padding="3dp"
        app:layout_constraintTop_toBottomOf="@id/statusPillLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tabPresentation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Slides"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/apple_text_primary"
            android:background="@drawable/bg_apple_tab_active" />

        <TextView
            android:id="@+id/tabAirMouse"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Mouse"
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/apple_text_secondary"
            android:background="@drawable/bg_apple_tab_inactive" />

        <TextView
            android:id="@+id/tabKeyboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Keyboard"
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/apple_text_secondary"
            android:background="@drawable/bg_apple_tab_inactive" />

        <TextView
            android:id="@+id/tabReels"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Media"
            android:textSize="12sp"
            android:textStyle="normal"
            android:textColor="@color/apple_text_secondary"
            android:background="@drawable/bg_apple_tab_inactive" />
    </LinearLayout>

    <!-- Main Mode Panels Container -->
    <FrameLayout
        android:id="@+id/panelsContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/modeTabBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBarLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ============================================================= -->
        <!-- MODE 1: SLIDES (PRESENTATION REMOTE)                          -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/panelPresentation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Slide Timer Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_apple_card"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ELAPSED TIME"
                    android:textColor="@color/apple_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvSlideTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/apple_text_primary"
                    android:textSize="20sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:layout_marginEnd="12dp" />

                <Button
                    android:id="@+id/btnResetTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Reset"
                    android:textSize="11sp"
                    android:textColor="@color/apple_text_secondary"
                    android:background="@drawable/bg_apple_btn_secondary"
                    android:paddingHorizontal="12dp" />
            </LinearLayout>

            <!-- Primary Next Slide Card -->
            <Button
                android:id="@+id/btnNextSlide"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.4"
                android:text="Next Slide  ›"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/apple_text_primary"
                android:background="@drawable/bg_apple_btn_primary"
                android:layout_marginBottom="10dp" />

            <!-- Secondary Previous Slide Card -->
            <Button
                android:id="@+id/btnPrevSlide"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.0"
                android:text="‹  Previous Slide"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/apple_text_primary"
                android:background="@drawable/bg_apple_btn_secondary"
                android:layout_marginBottom="12dp" />

            <!-- Tools Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnFullscreen"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="F5 Keynote"
                    android:textSize="12sp"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_btn_secondary"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnBlackScreen"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Blank (B)"
                    android:textSize="12sp"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_btn_secondary"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnTorchPointer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:text="🔦 Spotlight"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/apple_amber"
                    android:background="@drawable/bg_apple_btn_amber" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Volume rocker advances &amp; reverses slides hands-free"
                android:textColor="@color/apple_text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ============================================================= -->
        <!-- MODE 2: AIR MOUSE                                             -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/panelAirMouse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Gyro Telemetry Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_apple_card"
                android:paddingHorizontal="16dp"
                android:paddingVertical="11dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvGyroState"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pointer Active (100 Hz)"
                    android:textColor="@color/apple_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMotionReadout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="dX: 0  dY: 0"
                    android:textColor="@color/apple_text_secondary"
                    android:fontFamily="monospace"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Dual Click & Center Scroll Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <!-- Primary Left Click Pad -->
                <Button
                    android:id="@+id/btnLeftClick"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:text="Left Click"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_btn_primary"
                    android:layout_marginEnd="8dp" />

                <!-- Vertical Scroll Strip -->
                <LinearLayout
                    android:id="@+id/scrollWheelLayout"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="@drawable/bg_apple_card"
                    android:gravity="center"
                    android:layout_marginEnd="8dp">

                    <Button
                        android:id="@+id/btnScrollUp"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="▲"
                        android:textSize="16sp"
                        android:textColor="@color/apple_text_primary"
                        android:background="@android:color/transparent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SCROLL"
                        android:textSize="8sp"
                        android:textColor="@color/apple_text_tertiary" />

                    <Button
                        android:id="@+id/btnScrollDown"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="▼"
                        android:textSize="16sp"
                        android:textColor="@color/apple_text_primary"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <!-- Secondary Right Click Pad -->
                <Button
                    android:id="@+id/btnRightClick"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.0"
                    android:text="Right Click"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_btn_secondary" />
            </LinearLayout>

            <!-- Clutch & Recalibrate Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnClutch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.3"
                    android:text="Hold to Freeze Pointer"
                    android:textSize="12sp"
                    android:textColor="@color/apple_amber"
                    android:background="@drawable/bg_apple_btn_amber"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnCalibrate"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.0"
                    android:text="Recalibrate"
                    android:textSize="12sp"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_btn_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================= -->
        <!-- MODE 3: KEYBOARD (NEW APPLE WIRELESS KEYBOARD)                -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/panelKeyboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Live Text Input Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_apple_card"
                android:padding="8dp"
                android:layout_marginBottom="10dp">

                <EditText
                    android:id="@+id/etKeyboardInput"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_apple_input_field"
                    android:hint="Type text or use voice..."
                    android:textColorHint="@color/apple_text_tertiary"
                    android:textColor="@color/apple_text_primary"
                    android:textSize="13sp"
                    android:paddingHorizontal="12dp"
                    android:inputType="text"
                    android:imeOptions="actionSend" />

                <Button
                    android:id="@+id/btnSendText"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="Send ⏎"
                    android:textSize="12sp"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_btn_primary"
                    android:paddingHorizontal="14dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Quick Control Keys Row (Esc, Tab, Space, Backspace, Return) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnKeyEsc"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="esc"
                    android:textSize="11sp"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_key"
                    android:layout_marginEnd="5dp" />

                <Button
                    android:id="@+id/btnKeyTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="tab"
                    android:textSize="12sp"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_key"
                    android:layout_marginEnd="5dp" />

                <Button
                    android:id="@+id/btnKeySpace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.6"
                    android:text="space"
                    android:textSize="12sp"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_key"
                    android:layout_marginEnd="5dp" />

                <Button
                    android:id="@+id/btnKeyBackspace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:text="⌫"
                    android:textSize="15sp"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_key"
                    android:layout_marginEnd="5dp" />

                <Button
                    android:id="@+id/btnKeyReturn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:text="return"
                    android:textSize="11sp"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_key" />
            </LinearLayout>

            <!-- Shortcuts Row (Copy, Paste, Undo, Select All, Search) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btnShortcutUndo"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Undo"
                    android:textSize="11sp"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_key"
                    android:layout_marginEnd="5dp" />

                <Button
                    android:id="@+id/btnShortcutCopy"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Copy"
                    android:textSize="11sp"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_key"
                    android:layout_marginEnd="5dp" />

                <Button
                    android:id="@+id/btnShortcutPaste"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Paste"
                    android:textSize="11sp"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_key"
                    android:layout_marginEnd="5dp" />

                <Button
                    android:id="@+id/btnShortcutSelectAll"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Select"
                    android:textSize="11sp"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_key"
                    android:layout_marginEnd="5dp" />

                <Button
                    android:id="@+id/btnShortcutSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Find"
                    android:textSize="11sp"
                    android:textColor="@color/apple_blue"
                    android:background="@drawable/bg_apple_key" />
            </LinearLayout>

            <!-- Directional Navigation Cluster -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_apple_card"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ARROW NAVIGATION"
                    android:textColor="@color/apple_text_tertiary"
                    android:textSize="10sp"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnArrowUp"
                    android:layout_width="80dp"
                    android:layout_height="44dp"
                    android:text="▲"
                    android:textSize="16sp"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_key"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnArrowLeft"
                        android:layout_width="80dp"
                        android:layout_height="match_parent"
                        android:text="◀"
                        android:textSize="16sp"
                        android:textColor="@color/apple_text_primary"
                        android:background="@drawable/bg_apple_key"
                        android:layout_marginEnd="10dp" />

                    <Button
                        android:id="@+id/btnArrowDown"
                        android:layout_width="80dp"
                        android:layout_height="match_parent"
                        android:text="▼"
                        android:textSize="16sp"
                        android:textColor="@color/apple_text_primary"
                        android:background="@drawable/bg_apple_key"
                        android:layout_marginEnd="10dp" />

                    <Button
                        android:id="@+id/btnArrowRight"
                        android:layout_width="80dp"
                        android:layout_height="match_parent"
                        android:text="▶"
                        android:textSize="16sp"
                        android:textColor="@color/apple_text_primary"
                        android:background="@drawable/bg_apple_key" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================= -->
        <!-- MODE 4: MEDIA (REELS / SHORTS SCROLLER)                       -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/panelReels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Next Video Card -->
            <Button
                android:id="@+id/btnNextReel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.3"
                android:text="Next Video  ⌄"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/apple_text_primary"
                android:background="@drawable/bg_apple_btn_primary"
                android:layout_marginBottom="10dp" />

            <!-- Previous Video + Play/Pause Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.0"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btnPrevReel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="⌃  Previous Video"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_btn_secondary"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnPlayPauseReel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="⏯  Play / Pause"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_btn_secondary" />
            </LinearLayout>

            <!-- Volume & Quick Action Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnVolDown"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Volume −"
                    android:textSize="13sp"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_btn_secondary"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnVolUp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Volume +"
                    android:textSize="13sp"
                    android:textColor="@color/apple_text_primary"
                    android:background="@drawable/bg_apple_btn_secondary"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnLike"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Like ❤️"
                    android:textSize="13sp"
                    android:textColor="@color/apple_red"
                    android:background="@drawable/bg_apple_btn_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="TikTok, Instagram Reels, and YouTube Shorts compatible"
                android:textColor="@color/apple_text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Apple Action Bar -->
    <LinearLayout
        android:id="@+id/bottomBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Live Telemetry Monitor (Collapsible) -->
        <TextView
            android:id="@+id/tvTelemetryLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_apple_card"
            android:padding="8dp"
            android:text="Ready • 100 Hz IMU Pipeline Active"
            android:textColor="@color/apple_text_tertiary"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:maxLines="2"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <!-- Mode Cycle Pill & Telemetry Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCycleMode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Next Mode  ➔"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/apple_text_primary"
                android:background="@drawable/bg_apple_btn_secondary"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnToggleTelemetry"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="Diagnostics"
                android:textSize="11sp"
                android:textColor="@color/apple_text_secondary"
                android:background="@drawable/bg_apple_btn_secondary"
                android:paddingHorizontal="14dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
