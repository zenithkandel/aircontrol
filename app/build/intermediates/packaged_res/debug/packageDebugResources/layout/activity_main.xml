<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <!-- Top System Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SENTINAL"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AIRCONTROL • BLE HID"
                android:textColor="@color/cyan_accent"
                android:textSize="11sp"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Hardware Tri-LED Indicator Array -->
        <LinearLayout
            android:id="@+id/ledArrayLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_rounded"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="8dp">

            <!-- Mode LED -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="10dp">
                <View
                    android:id="@+id/ledMode"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_led_circle" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MODE"
                    android:textSize="8sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <!-- Status / BLE LED -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="10dp">
                <View
                    android:id="@+id/ledStatus"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_led_circle" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BLE"
                    android:textSize="8sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <!-- Action LED -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <View
                    android:id="@+id/ledAction"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_led_circle" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACT"
                    android:textSize="8sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>
        </LinearLayout>

        <!-- Settings Button -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_btn_secondary"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="@color/text_secondary"
            android:contentDescription="Settings" />
    </LinearLayout>

    <!-- Connection Status Pill -->
    <LinearLayout
        android:id="@+id/statusPillLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card_rounded"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/dotConnection"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_led_circle"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ADVERTISING AS 'SENTINAL'"
            android:textColor="@color/cyan_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDeviceTarget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAIR IN PC BLUETOOTH"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Operating Mode Selector Bar -->
    <LinearLayout
        android:id="@+id/modeTabBar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_card_rounded"
        android:padding="3dp"
        app:layout_constraintTop_toBottomOf="@id/statusPillLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tabPresentation"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1: SLIDES"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/cyan_accent"
            android:background="@drawable/bg_tab_selected" />

        <TextView
            android:id="@+id/tabAirMouse"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="2: MOUSE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_tab_unselected" />

        <TextView
            android:id="@+id/tabReels"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="3: REELS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_tab_unselected" />
    </LinearLayout>

    <!-- Panels Container -->
    <FrameLayout
        android:id="@+id/panelsContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/modeTabBar"
        app:layout_constraintBottom_toTopOf="@id/bottomBarLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ============================================================= -->
        <!-- PANEL 1: PRESENTATION REMOTE (MODE 1)                          -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/panelPresentation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Slide Stopwatch Timer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_rounded"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRESENTATION TIMER"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.05" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvSlideTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@color/amber_accent"
                    android:textSize="18sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:layout_marginEnd="12dp" />

                <Button
                    android:id="@+id/btnResetTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="RESET"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/bg_btn_secondary"
                    android:paddingHorizontal="10dp" />
            </LinearLayout>

            <!-- Big NEXT SLIDE Button -->
            <Button
                android:id="@+id/btnNextSlide"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.4"
                android:text="NEXT SLIDE  ▶"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/cyan_accent"
                android:background="@drawable/bg_btn_primary"
                android:layout_marginBottom="10dp" />

            <!-- Big PREVIOUS SLIDE Button -->
            <Button
                android:id="@+id/btnPrevSlide"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.0"
                android:text="◀  PREV SLIDE"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_secondary"
                android:layout_marginBottom="12dp" />

            <!-- Secondary Controls Row (Fullscreen, Black Screen, Torch) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnFullscreen"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="F5 FULLSCREEN"
                    android:textSize="11sp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_btn_secondary"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnBlackScreen"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="BLACK SCREEN"
                    android:textSize="11sp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_btn_secondary"
                    android:layout_marginEnd="6dp" />

                <!-- Laser Pointer / Torch Spotlight Trigger -->
                <Button
                    android:id="@+id/btnTorchPointer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.1"
                    android:text="🔦 TORCH BEAM"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/amber_accent"
                    android:background="@drawable/bg_btn_accent" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="⚡ Physical volume keys advance &amp; reverse slides hands-free"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ============================================================= -->
        <!-- PANEL 2: 6-AXIS AIR MOUSE (MODE 2)                            -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/panelAirMouse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Gyro Motion Radar & Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_rounded"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvGyroState"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GYRO ACTIVE (100 Hz)"
                    android:textColor="@color/neon_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMotionReadout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="dX: 0  dY: 0"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="monospace"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Mouse Buttons & Scroll Wheel Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <!-- Left Click Pad (Button A) -->
                <Button
                    android:id="@+id/btnLeftClick"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:text="LEFT CLICK\n(BUTTON A)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/cyan_accent"
                    android:background="@drawable/bg_btn_primary"
                    android:layout_marginEnd="8dp" />

                <!-- Center Scroll Wheel Column -->
                <LinearLayout
                    android:id="@+id/scrollWheelLayout"
                    android:layout_width="64dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_rounded"
                    android:gravity="center"
                    android:layout_marginEnd="8dp">

                    <Button
                        android:id="@+id/btnScrollUp"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="▲"
                        android:textSize="18sp"
                        android:textColor="@color/text_primary"
                        android:background="@android:color/transparent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SCROLL"
                        android:textSize="9sp"
                        android:textColor="@color/text_muted" />

                    <Button
                        android:id="@+id/btnScrollDown"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="▼"
                        android:textSize="18sp"
                        android:textColor="@color/text_primary"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <!-- Right Click Pad (Button B) -->
                <Button
                    android:id="@+id/btnRightClick"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.0"
                    android:text="RIGHT CLICK\n(BUTTON B)"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_btn_secondary" />
            </LinearLayout>

            <!-- Clutch / Freeze Motion & Recalibration Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal">

                <!-- Clutch / Freeze Button -->
                <Button
                    android:id="@+id/btnClutch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:text="HOLD TO FREEZE POINTER"
                    android:textSize="11sp"
                    android:textColor="@color/amber_accent"
                    android:background="@drawable/bg_btn_accent"
                    android:layout_marginEnd="6dp" />

                <!-- Stationary Zero-Rate Recalibration -->
                <Button
                    android:id="@+id/btnCalibrate"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.0"
                    android:text="RECALIBRATE"
                    android:textSize="11sp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_btn_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================= -->
        <!-- PANEL 3: REEL / SHORT SCROLLER (MODE 3)                       -->
        <!-- ============================================================= -->
        <LinearLayout
            android:id="@+id/panelReels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Next Video Button (DOWN_ARROW) -->
            <Button
                android:id="@+id/btnNextReel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.3"
                android:text="NEXT VIDEO  ▼"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/cyan_accent"
                android:background="@drawable/bg_btn_primary"
                android:layout_marginBottom="10dp" />

            <!-- Center Row: Previous Video + Play/Pause -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.0"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btnPrevReel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="▲  PREV VIDEO"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_btn_secondary"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnPlayPauseReel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="⏯ PLAY / PAUSE"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/amber_accent"
                    android:background="@drawable/bg_btn_accent" />
            </LinearLayout>

            <!-- Volume / Media Quick Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnVolDown"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="VOL -"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_btn_secondary"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnVolUp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="VOL +"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_btn_secondary"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnLike"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="❤️ LIKE"
                    android:textSize="13sp"
                    android:textColor="@color/neon_pink"
                    android:background="@drawable/bg_btn_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="⚡ TikTok, Instagram Reels, YouTube Shorts compatible"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Action & Telemetry Bar -->
    <LinearLayout
        android:id="@+id/bottomBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Live Telemetry Monitor (Collapsible) -->
        <TextView
            android:id="@+id/tvTelemetryLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:padding="8dp"
            android:text="[CDC] Ready. Tap 'CYCLE MODE' to switch 1 -> 2 -> 3."
            android:textColor="@color/text_muted"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:maxLines="2"
            android:layout_marginBottom="8dp" />

        <!-- Bottom Mode Cycle Button (GPIO 7 hardware simulator) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCycleMode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="CYCLE OPERATING MODE  (1 ➔ 2 ➔ 3)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_secondary"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnToggleTelemetry"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="DIAG"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_btn_secondary"
                android:paddingHorizontal="14dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
